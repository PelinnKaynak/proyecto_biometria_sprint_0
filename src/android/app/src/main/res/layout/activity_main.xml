<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla principal: título y los tres botones del escaneo BTLE,
     centrados en una tarjeta. Los id y onClick son los del código original. -->
<!-- (NUEVO) ScrollView: si el texto del estado es largo, se puede desplazar la pantalla y no se corta -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/fondo"
    tools:context=".MainActivity">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PelinIBeacon"
        android:textColor="@color/verde_oscuro"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="24dp"
        android:text="Proyecto Biometría · Sprint 0"
        android:textColor="@color/texto_suave"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/tarjeta"
        android:elevation="4dp"
        android:padding="20dp">

        <Button
            android:id="@+id/botonBuscarNuestroDispositivoBTLE"
            android:text="Buscar nuestro dispositivo BTLE"
            android:onClick="botonBuscarNuestroDispositivoBTLEPulsado"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/boton_principal"
            android:stateListAnimator="@null"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/botonBuscarDispositivosBTLE"
            android:text="Buscar todos los dispositivos BTLE"
            android:onClick="botonBuscarDispositivosBTLEPulsado"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/boton_secundario"
            android:stateListAnimator="@null"
            android:textAllCaps="false"
            android:textColor="@color/verde"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/botonDetenerBusquedaDispositivosBTLE"
            android:text="Detener búsqueda"
            android:onClick="botonDetenerBusquedaDispositivosBTLEPulsado"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/boton_detener"
            android:stateListAnimator="@null"
            android:textAllCaps="false"
            android:textColor="@color/rojo"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- (NUEVO) tarjeta con la última medición recibida y el estado de la app -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/tarjeta"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Última medición recibida"
            android:textColor="@color/texto_suave"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/textoUltimaMedicion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="—"
            android:textColor="@color/verde_oscuro"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Estado"
            android:textColor="@color/texto_suave"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/textoEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Iniciando..."
            android:textColor="@color/texto"
            android:textSize="15sp" />

    </LinearLayout>

</LinearLayout>

</ScrollView>
